# Supabase connection (Project Settings > API in the Supabase dashboard).
# Copy this file to .env and fill both values in. With either one missing the app runs in demo mode:
# no login, all data stays in this browser.
#
# Only the project URL and the public "anon" key belong here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the shared password of the three demo accounts (admin@pivora.test, manager@pivora.test, rep@pivora.test).
# When set, the sign-in page shows "Explore as Admin / Manager / Sales rep" buttons. Leave it out to hide them.
# This value ends up in the public JavaScript bundle, so use it only for throwaway accounts that hold sample data.
VITE_DEMO_PASSWORD=your-demo-account-password
