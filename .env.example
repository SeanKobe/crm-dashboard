# Supabase connection (Project Settings > API in the Supabase dashboard).
# Copy this file to .env and fill both values in. With either one missing the app runs in demo mode:
# no login, all data stays in this browser.
#
# Only the project URL and the public "anon" key belong here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
